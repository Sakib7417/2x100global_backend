# ============================================================================
# TRADING CONFIGURATION
# ============================================================================
MORNING_TRADE_TIME=09:00
EVENING_TRADE_TIME=18:00
# NOTE: vars below only seed the admin Settings panel. Actual logic uses code
# constants: trade = 1% of Principal, settles instantly, 60/40 profit split.
TRADE_DURATION_MINUTES=2
TRADE_PERCENTAGE=1
PROFIT_DISTRIBUTION_USER=60
PROFIT_DISTRIBUTION_ADMIN=40

# ============================================================================
# DEPOSIT CONFIGURATION
# ============================================================================
MINIMUM_DEPOSIT=100
# Deposit bonus is tiered in code (deposit.constants.ts): ≤300 → 5%, ≤1000 → 8%, >1000 → 10%

# ============================================================================
# REFERRAL CONFIGURATION
# ============================================================================
# Display-only — actual tiers are in referral.constants.ts:
# deposit 50-999 → sponsor gets 5%, ≥1000 → 10% (no upper cap)
REFERRAL_BONUS_TIER1_MIN=50
REFERRAL_BONUS_TIER1_MAX=999
REFERRAL_BONUS_TIER1_PERCENTAGE=5
REFERRAL_BONUS_TIER2_MIN=1000
REFERRAL_BONUS_TIER2_MAX=9999
REFERRAL_BONUS_TIER2_PERCENTAGE=10

# ============================================================================
# WITHDRAWAL CONFIGURATION
# ============================================================================
WITHDRAWAL_FEE_PERCENTAGE=15
# Principal withdrawal penalty: 40% until user completes 140 of 200 plan trades
WITHDRAWAL_PENALTY_PERCENTAGE=40
MINIMUM_WITHDRAWAL=10

# ============================================================================
# CYCLE BONUS CONFIGURATION
