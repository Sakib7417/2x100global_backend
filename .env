SWAGGER_TITLE=2x100 Global API
SWAGGER_DESCRIPTION=2x100 Global Auto-Trading, Referral & Reward Platform
SWAGGER_VERSION=1.0.0
SWAGGER_CONTACT_EMAIL=support@2x100global.com

# ============================================================================
# CRON CONFIGURATION
# ============================================================================
# Trade sessions open at MORNING_TRADE_TIME / EVENING_TRADE_TIME (settings table
# overrides env) — these two cron vars are unused.
# CRON_MORNING_TRADE=0 9 * * *
# CRON_EVENING_TRADE=0 18 * * *
CRON_TRADE_SETTLEMENT=*/2 * * * *
CRON_DEPOSIT_VERIFICATION=*/5 * * * *
CRON_RANK_EVALUATION=0 0 * * *
CRON_POOL_BONUS=0 0 */10 * *
CRON_NOTIFICATION_SENDER=*/10 * * * *
CRON_DAILY_REPORT=0 23 * * *
CRON_FAILED_RETRY=0 */30 * * *

