# ============================================================================
# SECURITY CONFIGURATION
# ============================================================================
BCRYPT_ROUNDS=10
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
# Auth endpoints (login, refresh, forgot/reset password) — only failed attempts count
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=10
CORS_ORIGIN=http://localhost:3000

# ============================================================================
# LOGGING CONFIGURATION
# ============================================================================
LOG_LEVEL=info
LOG_DIR=logs
LOG_FILE_API=api.log
LOG_FILE_ERROR=error.log
LOG_FILE_TRADE=trade.log
LOG_FILE_BLOCKCHAIN=blockchain.log
LOG_FILE_CRON=cron.log
LOG_FILE_SECURITY=security.log

# ============================================================================
# SWAGGER CONFIGURATION
