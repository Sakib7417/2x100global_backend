generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                      String               @id @default(uuid())
  email                   String               @unique
  password                String
  name                    String?
  phone                   String?
  country                 String?
  role                    UserRole             @default(USER)
  referralCode            String               @unique
  sponsorId               String?              @map("sponsor_id")
  walletAddress           String?
  rank                    RankLevel            @default(LV1)
  autoTradeStatus         Boolean              @default(false)
  status                  UserStatus           @default(INACTIVE)
  isContentCreator        Boolean              @default(false) @map("is_content_creator")
  lastLogin               DateTime?
  sponsorTradeBonusExpiry DateTime?            @map("sponsor_trade_bonus_expiry")
  sponsorTradeBonusRate   Float?               @map("sponsor_trade_bonus_rate")
  govIdType               GovIdType?           @map("gov_id_type")
  createdAt               DateTime             @default(now())
  updatedAt               DateTime             @updatedAt
  deletedAt               DateTime?
  emailOtp                String?              @map("email_otp")
  emailOtpExpiresAt       DateTime?            @map("email_otp_expires_at")
  emailOtpPurpose         String?              @map("email_otp_purpose")
  emailVerified           Boolean              @default(false) @map("email_verified")
  withdrawPasswordHash    String?              @map("withdraw_password_hash")
  withdrawPasswordSetAt   DateTime?            @map("withdraw_password_set_at")
  govIdUrl                String?              @map("gov_id_url")
  auditLogsAsUser         AuditLog[]           @relation("UserAuditLogs")
  cycleBonuses            CycleBonus[]
  deposits                Deposit[]
  ledgers                 Ledger[]
  news                    News[]               @relation("NewsAuthor")
  notifications           Notification[]
  passwordResetTokens     PasswordResetToken[]
  adminPoolBonusRequests  PoolBonusRequest[]   @relation("AdminPoolBonusRequests")
  poolBonusRequests       PoolBonusRequest[]   @relation("UserPoolBonusRequests")
  posts                   Post[]               @relation("PostAuthor")
  ranks                   Rank?
  referralBonuses         ReferralBonus[]
  referralAsSponsor       Referral[]           @relation("SponsorReferrals")
  referralAsReferred      Referral?            @relation("UserReferral")
  refreshTokens           RefreshToken[]
  settingsUpdated         Setting[]            @relation("SettingsUpdater")
  ticketMessages          TicketMessage[]      @relation("TicketMessageSender")
  adminTickets            Ticket[]             @relation("AdminHandledTickets")
  tickets                 Ticket[]             @relation("UserTickets")
  trades                  Trade[]
  tradeExclusion        TradeExclusion?
  sponsor                 User?                @relation("SponsorReferrals", fields: [sponsorId], references: [id])
  referrals               User[]               @relation("SponsorReferrals")
  wallets                 Wallet[]
  withdrawalsProcessed    Withdrawal[]         @relation("AdminWithdrawals")
  withdrawals             Withdrawal[]

  @@index([email])
  @@index([referralCode])
  @@index([sponsorId])
  @@index([rank])
  @@index([status])
  @@index([autoTradeStatus])
  @@map("users")
}

model Wallet {
  id          String     @id @default(uuid())
  userId      String     @map("user_id")
  type        WalletType
  balance     Decimal    @default(0) @db.Decimal(20, 8)
  totalCredit Decimal    @default(0) @map("total_credit") @db.Decimal(20, 8)
  totalDebit  Decimal    @default(0) @map("total_debit") @db.Decimal(20, 8)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  ledgers     Ledger[]
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, type])
  @@index([userId])
  @@index([type])
  @@map("wallets")
}

model Ledger {
  id            String         @id @default(uuid())
  userId        String         @map("user_id")
  walletId      String         @map("wallet_id")
  type          LedgerType
  referenceId   String?        @map("reference_id")
  referenceType ReferenceType?
  beforeBalance Decimal        @map("before_balance") @db.Decimal(20, 8)
  afterBalance  Decimal        @map("after_balance") @db.Decimal(20, 8)
  credit        Decimal        @default(0) @db.Decimal(20, 8)
  debit         Decimal        @default(0) @db.Decimal(20, 8)
  description   String?
  metadata      Json?
  createdAt     DateTime       @default(now())
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  wallet        Wallet         @relation(fields: [walletId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([walletId])
  @@index([referenceId])
  @@index([type])
  @@index([createdAt])
  @@map("ledgers")
}

model Deposit {
  id                    String          @id @default(uuid())
  userId                String          @map("user_id")
  amount                Decimal         @db.Decimal(20, 8)
  transactionHash       String          @unique @map("transaction_hash")
  senderAddress         String          @map("sender_address")
  receiverAddress       String          @map("receiver_address")
  tokenContract         String          @map("token_contract")
  network               String
  blockNumber           BigInt?         @map("block_number")
  confirmations         Int             @default(0)
  requiredConfirmations Int             @default(12) @map("required_confirmations")
  status                DepositStatus
  bonusAmount           Decimal         @default(0) @map("bonus_amount") @db.Decimal(20, 8)
  blockchainData        Json?           @map("blockchain_data")
  verifiedAt            DateTime?       @map("verified_at")
  approvedAt            DateTime?       @map("approved_at")
  rejectionReason       String?         @map("rejection_reason")
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt
  user                  User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  referralBonuses       ReferralBonus[]

  @@index([userId])
  @@index([transactionHash])
  @@index([status])
  @@index([createdAt])
  @@map("deposits")
}

model Withdrawal {
  id                 String               @id @default(uuid())
  userId             String               @map("user_id")
  walletType         WithdrawalWalletType @map("wallet_type")
  amount             Decimal              @db.Decimal(20, 8)
  fee                Decimal              @default(0) @db.Decimal(20, 8)
  penalty            Decimal              @default(0) @db.Decimal(20, 8)
  netAmount          Decimal              @map("net_amount") @db.Decimal(20, 8)
  destinationAddress String               @map("destination_address")
  transactionHash    String?              @unique @map("transaction_hash")
  network            String
  gasFee             Decimal?             @map("gas_fee") @db.Decimal(20, 8)
  status             WithdrawalStatus
  adminId            String?              @map("admin_id")
  processedAt        DateTime?            @map("processed_at")
  rejectionReason    String?              @map("rejection_reason")
  blockchainData     Json?                @map("blockchain_data")
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  admin              User?                @relation("AdminWithdrawals", fields: [adminId], references: [id])
  user               User                 @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([transactionHash])
  @@index([status])
  @@index([walletType])
  @@index([createdAt])
  @@map("withdrawals")
}

model Trade {
  id               String        @id @default(uuid())
  userId           String        @map("user_id")
  sessionId        String?       @map("session_id")
  tradeAmount      Decimal       @map("trade_amount") @db.Decimal(20, 8)
  profit           Decimal       @default(0) @db.Decimal(20, 8)
  commission       Decimal       @default(0) @db.Decimal(20, 8)
  status           TradeStatus
  entryTime        DateTime      @map("entry_time")
  exitTime         DateTime?     @map("exit_time")
  settlementTime   DateTime?     @map("settlement_time")
  tradeType        TradeType     @map("trade_type")
  profitPercentage Decimal?      @map("profit_percentage") @db.Decimal(5, 2)
  metadata         Json?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  user             User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  session          TradeSession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)

  // One trade per user per session — a second submit for the same session
  // violates this constraint at the DB level, closing the race window.
  @@unique([userId, sessionId])
  @@index([userId])
  @@index([status])
  @@index([entryTime])
  @@index([tradeType])
  @@index([sessionId])
  @@map("trades")
}

model TradeSession {
  id          String    @id @default(uuid())
  sessionType TradeType @map("session_type")
  code        String
  generatedAt DateTime  @default(now()) @map("generated_at")
  expiresAt   DateTime  @map("expires_at")
  isActive    Boolean   @default(true) @map("is_active")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  trades      Trade[]

  @@index([isActive, expiresAt])
  @@map("trade_sessions")
}

model TradeExclusion {
  id        String   @id @default(uuid())
  userId    String   @unique @map("user_id")
  reason    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("trade_exclusions")
}

model Referral {
  id                  String          @id @default(uuid())
  userId              String          @unique @map("user_id")
  sponsorId           String?         @map("sponsor_id")
  level               Int
  directDepositAmount Decimal         @default(0) @map("direct_deposit_amount") @db.Decimal(20, 8)
  teamDepositAmount   Decimal         @default(0) @map("team_deposit_amount") @db.Decimal(20, 8)
  directReferralCount Int             @default(0) @map("direct_referral_count")
  teamSize            Int             @default(0)
  totalBonusEarned    Decimal         @default(0) @map("total_bonus_earned") @db.Decimal(20, 8)
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt
  referralBonuses     ReferralBonus[]
  sponsor             User?           @relation("SponsorReferrals", fields: [sponsorId], references: [id], onDelete: Cascade)
  user                User            @relation("UserReferral", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([sponsorId])
  @@index([level])
  @@index([directReferralCount])
  @@map("referrals")
}

model ReferralBonus {
  id              String        @id @default(uuid())
  referralId      String        @map("referral_id")
  userId          String        @map("user_id")
  depositId       String        @map("deposit_id")
  depositAmount   Decimal       @map("deposit_amount") @db.Decimal(20, 8)
  bonusPercentage Decimal       @map("bonus_percentage") @db.Decimal(5, 2)
  bonusAmount     Decimal       @map("bonus_amount") @db.Decimal(20, 8)
  level           Int
  status          DepositStatus
  creditedAt      DateTime?     @map("credited_at")
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  deposit         Deposit       @relation(fields: [depositId], references: [id], onDelete: Cascade)
  referral        Referral      @relation(fields: [referralId], references: [id], onDelete: Cascade)
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([referralId])
  @@index([userId])
  @@index([depositId])
  @@index([status])
  @@index([createdAt])
  @@map("referral_bonuses")
}

model Rank {
  id                    String       @id @default(uuid())
  userId                String       @unique @map("user_id")
  level                 RankLevel
  directReferrals       Int          @default(0) @map("direct_referrals")
  teamSize              Int          @default(0) @map("team_size")
  directLv1Count        Int          @default(0) @map("direct_lv1_count")
  requirements          Json?
  achievedAt            DateTime     @map("achieved_at")
  totalRankBonusEarned  Decimal      @default(0) @map("total_rank_bonus_earned") @db.Decimal(20, 8)
  totalCycleBonusEarned Decimal      @default(0) @map("total_cycle_bonus_earned") @db.Decimal(20, 8)
  createdAt             DateTime     @default(now())
  updatedAt             DateTime     @updatedAt
  cycleBonuses          CycleBonus[]
  user                  User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([level])
  @@index([achievedAt])
  @@map("ranks")
}

model RankHistory {
  id            String     @id @default(uuid())
  userId        String     @map("user_id")
  previousLevel RankLevel? @map("previous_level")
  newLevel      RankLevel  @map("new_level")
  changeReason  String?    @map("change_reason")
  changedAt     DateTime   @map("changed_at")
  createdAt     DateTime   @default(now())

  @@index([userId])
  @@index([changedAt])
  @@map("rank_history")
}

model CycleBonus {
  id               String           @id @default(uuid())
  userId           String           @map("user_id")
  rankId           String           @map("rank_id")
  rankLevel        RankLevel        @map("rank_level")
  cycleNumber      Int              @map("cycle_number")
  cycleStartDate   DateTime         @map("cycle_start_date")
  cycleEndDate     DateTime         @map("cycle_end_date")
  rankBonusAmount  Decimal          @map("rank_bonus_amount") @db.Decimal(20, 8)
  cycleBonusAmount Decimal          @map("cycle_bonus_amount") @db.Decimal(20, 8)
  totalAmount      Decimal          @map("total_amount") @db.Decimal(20, 8)
  status           CycleBonusStatus
  creditedAt       DateTime?        @map("credited_at")
  eligibilityData  Json?            @map("eligibility_data")
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  rank             Rank             @relation(fields: [rankId], references: [id], onDelete: Cascade)
  user             User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, cycleNumber])
  @@index([userId])
  @@index([rankId])
  @@index([status])
  @@index([cycleStartDate])
  @@map("cycle_bonuses")
}

model PoolBonusRequest {
  id                 String                 @id @default(uuid())
  userId             String                 @map("user_id")
  requestType        PoolBonusRequestType   @map("request_type")
  requestedAmount    Decimal                @map("requested_amount") @db.Decimal(20, 8)
  approvedAmount     Decimal?               @map("approved_amount") @db.Decimal(20, 8)
  status             PoolBonusRequestStatus @default(PENDING)
  destinationAddress String?                @map("destination_address")
  network            String?
  adminId            String?                @map("admin_id")
  approvedAt         DateTime?              @map("approved_at")
  rejectionReason    String?                @map("rejection_reason")
  adminNote          String?                @map("admin_note")
  processedAt        DateTime?              @map("processed_at")
  transactionHash    String?                @map("transaction_hash")
  failureReason      String?                @map("failure_reason")
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt
  admin              User?                  @relation("AdminPoolBonusRequests", fields: [adminId], references: [id])
  user               User                   @relation("UserPoolBonusRequests", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
  @@index([requestType])
  @@index([adminId])
  @@index([createdAt])
  @@map("pool_bonus_requests")
}

model RefreshToken {
  id            String    @id @default(uuid())
  userId        String    @map("user_id")
  token         String    @unique
  expiresAt     DateTime  @map("expires_at")
  createdAt     DateTime  @default(now())
  revokedAt     DateTime? @map("revoked_at")
  revokedReason String?   @map("revoked_reason")
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  token     String    @unique
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
  @@index([expiresAt])
  @@map("password_reset_tokens")
}

model Notification {
  id        String           @id @default(uuid())
  userId    String           @map("user_id")
  type      NotificationType
  title     String
  message   String
  data      Json?
  read      Boolean          @default(false)
  readAt    DateTime?        @map("read_at")
  createdAt DateTime         @default(now())
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([type])
  @@index([read])
  @@index([createdAt])
  @@map("notifications")
}

model Setting {
  id          String   @id @default(uuid())
  key         String   @unique
  value       String
  description String?
  category    String?
  updatedAt   DateTime @updatedAt
  updatedBy   String?  @map("updated_by")
  updater     User?    @relation("SettingsUpdater", fields: [updatedBy], references: [id])

  @@index([key])
  @@index([category])
  @@map("settings")
}

model BlockchainTransaction {
  id              String                      @id @default(uuid())
  transactionHash String                      @unique @map("transaction_hash")
  type            BlockchainTransactionType
  fromAddress     String                      @map("from_address")
  toAddress       String                      @map("to_address")
  amount          Decimal                     @db.Decimal(20, 8)
  tokenContract   String                      @map("token_contract")
  network         String
  blockNumber     BigInt?                     @map("block_number")
  confirmations   Int
  status          BlockchainTransactionStatus
  rawTransaction  Json?                       @map("raw_transaction")
  receipt         Json?
  verifiedAt      DateTime?                   @map("verified_at")
  createdAt       DateTime                    @default(now())
  updatedAt       DateTime                    @updatedAt

  @@index([transactionHash])
  @@index([status])
  @@index([type])
  @@index([createdAt])
  @@map("blockchain_transactions")
}

model CronLog {
  id               String        @id @default(uuid())
  jobName          String        @map("job_name")
  status           CronJobStatus
  startTime        DateTime      @map("start_time")
  endTime          DateTime?     @map("end_time")
  duration         Int?
  recordsProcessed Int           @default(0) @map("records_processed")
  recordsFailed    Int           @default(0) @map("records_failed")
  errorMessage     String?       @map("error_message")
  metadata         Json?
  createdAt        DateTime      @default(now())

  @@index([jobName])
  @@index([status])
  @@index([startTime])
  @@map("cron_logs")
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?  @map("user_id")
  action    String
  entity    String
  entityId  String?  @map("entity_id")
  changes   Json?
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  createdAt DateTime @default(now())
  user      User?    @relation("UserAuditLogs", fields: [userId], references: [id])

  @@index([userId])
  @@index([action])
  @@index([entity])
  @@index([createdAt])
  @@map("audit_logs")
}

model Post {
  id          String   @id @default(uuid())
  title       String
  description String
  imageUrl    String   @map("image_url")
  isActive    Boolean  @default(true) @map("is_active")
  sortOrder   Int      @default(0) @map("sort_order")
  authorId    String?  @map("author_id")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  author      User?    @relation("PostAuthor", fields: [authorId], references: [id])

  @@index([isActive])
  @@index([sortOrder])
  @@index([createdAt])
  @@index([authorId])
  @@map("posts")
}

model News {
  id        String   @id @default(uuid())
  title     String
  message   String
  isActive  Boolean  @default(true) @map("is_active")
  sortOrder Int      @default(0) @map("sort_order")
  authorId  String?  @map("author_id")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  author    User?    @relation("NewsAuthor", fields: [authorId], references: [id])

  @@index([isActive])
  @@index([sortOrder])
  @@index([createdAt])
  @@index([authorId])
  @@map("news")
}

model Ticket {
  id        String          @id @default(uuid())
  userId    String          @map("user_id")
  subject   String
  status    TicketStatus    @default(OPEN)
  priority  TicketPriority  @default(MEDIUM)
  adminId   String?         @map("admin_id")
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  messages  TicketMessage[]
  admin     User?           @relation("AdminHandledTickets", fields: [adminId], references: [id])
  user      User            @relation("UserTickets", fields: [userId], references: [id])

  @@index([userId])
  @@index([status])
  @@index([priority])
  @@index([createdAt])
  @@map("tickets")
}

model TicketMessage {
  id          String   @id @default(uuid())
  ticketId    String   @map("ticket_id")
  senderId    String   @map("sender_id")
  isAdmin     Boolean  @default(false) @map("is_admin")
  message     String
  /// JSON array of relative image paths, e.g. ["/uploads/tickets/ticket-123.jpg"]
  attachments Json?
  createdAt   DateTime @default(now())
  sender      User     @relation("TicketMessageSender", fields: [senderId], references: [id])
  ticket      Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId])
  @@index([senderId])
  @@index([createdAt])
  @@map("ticket_messages")
}

enum UserRole {
  ADMIN
  USER
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum WalletType {
  PRINCIPAL
  DEPOSIT_BONUS
  REFERRAL
  TRADING_PROFIT
  RANK_BONUS
  POOL_BONUS
  ADMIN_COMMISSION
}

enum LedgerType {
  DEPOSIT
  DEPOSIT_BONUS
  REFERRAL_BONUS
  TRADE_ENTRY
  TRADE_PROFIT
  ADMIN_COMMISSION
  COMPOUND_TRANSFER
  WITHDRAWAL
  WITHDRAWAL_FEE
  PENALTY
  RANK_BONUS
  POOL_BONUS
  REFUND
  ADJUSTMENT
  TRADE_EXIT
  AUTO_TRADE_ENTRY
  TRADE_CANCEL
}

enum ReferenceType {
  DEPOSIT
  WITHDRAWAL
  TRADE
  REFERRAL
  RANK
  CYCLE
  WALLET
  AUTO_TRADE
  SYSTEM
}

enum DepositStatus {
  PENDING
  VERIFIED
  APPROVED
  REJECTED
  FAILED
}

enum WithdrawalStatus {
  PENDING
  PROCESSING
  COMPLETED
  REJECTED
  FAILED
}

enum WithdrawalWalletType {
  PRINCIPAL
  TRADING_PROFIT
  REFERRAL
  DEPOSIT_BONUS
  RANK_BONUS
  POOL_BONUS
}

enum TradeStatus {
  PENDING
  ACTIVE
  COMPLETED
  FAILED
  CANCELLED
}

enum TradeType {
  MORNING
  EVENING
}

enum RankLevel {
  LV1
  LV2
  LV3
  LV4
  LV5
  LV6
  LV7
}

enum CycleBonusStatus {
  PENDING
  CREDITED
  FAILED
}

enum NotificationType {
  DEPOSIT
  WITHDRAWAL
  TRADE
  REFERRAL
  RANK
  CYCLE
  SYSTEM
  SECURITY
}

enum BlockchainTransactionType {
  DEPOSIT
  WITHDRAWAL
}

enum BlockchainTransactionStatus {
  PENDING
  CONFIRMED
  FAILED
}

enum CronJobStatus {
  SUCCESS
  FAILED
  PARTIAL
}

enum PoolBonusRequestStatus {
  PENDING
  APPROVED
  REJECTED
  PROCESSED
  FAILED
}

enum PoolBonusRequestType {
  TRANSFER_TO_PRINCIPAL
  WITHDRAW
}

enum GovIdType {
  AADHAAR
  PAN
  PASSPORT
  DRIVING_LICENSE
  VOTER_ID
}

enum TicketStatus {
  OPEN
  REPLIED
  CLOSED
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
}
